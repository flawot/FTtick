{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ftick",
  "version": "0.1.0",
  "identifier": "com.flawot.ftick",
  "build": {
    "devUrl": "http://192.168.1.154:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ftick",
        "width": 300,
        "height": 300,
        "minWidth": 300,
        "minHeight": 300,
        "maxWidth": 300,
        "maxHeight": 300,
        "resizable": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "minSdkVersion": 26
    }
  }
}
